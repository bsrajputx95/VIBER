# ─── Provider API Keys (at least one required) ───
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# XAI_API_KEY=...
# MISTRAL_API_KEY=...
# COHERE_API_KEY=...
# TOGETHER_API_KEY=...

# ─── Database (Vercel Postgres recommended for production) ───
# For local development: DATABASE_URL="file:./dev.db"
# For Vercel/production: DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# ─── Authentication ───
NEXTAUTH_SECRET="generate-a-random-secret-here"
# NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── Optional: OAuth Providers ───
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
